<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ========== 권한 설명 (개인정보) ==========
      · READ_CONTACTS  : 폰에 저장된 친구/가족 연락처를 불러오기 위함
      · CALL_PHONE     : "전화 걸어줘" 시 바로 전화를 걸기 위함
      · READ_CALL_LOG  : 최근 한 달간 자주 통화한 사람을 자동으로 찾기 위함
      · READ_SMS       : 최근 한 달간 문자를 주고받은 사람을 자동으로 찾기 위함
      · SEND_SMS       : 가족/친구에게 안부 문자를 보내기 위함
      · WRITE_CONTACTS : 자주 연락하는 사람을 '가까운 친구' 즐겨찾기로 표시하기 위함
      모든 데이터는 기기 안에서만 처리되며 외부 서버로 전송하지 않습니다.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 음성으로 전화 걸기(선택 기능)를 위해 음성 인식 앱 조회 -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".AnnyeongApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Annyeong">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Annyeong">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
