# Émelle — 환경 변수 템플릿
# 실제 값은 .env.local 파일에 입력 (이 파일은 git에 커밋되지 않음)
# 참고: cp .env.local.example .env.local

# === Site ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Supabase (Phase 2부터 사용) ===
# https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Anthropic Claude API (카톡 Q&A 파싱용) ===
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# === 토스페이먼츠 (Phase 2 결제 연동) ===
# https://developers.tosspayments.com/
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# === 이메일 발송 (Resend 권장) ===
# https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Émelle <noreply@emelle.co.kr>"

# === 국세청 사업자등록 진위확인 API (Phase 2) ===
# https://www.data.go.kr/data/15081808/openapi.do
NTSBIZ_API_KEY=
